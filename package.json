{
    "name": "haritorax-interpreter",
    "version": "4.0.0-dev.0",
    "homepage": "https://github.com/JovannMC/haritorax-interpreter",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JovannMC/haritorax-interpreter.git"
    },
    "bugs": {
        "url": "https://github.com/JovannMC/haritorax-interpreter/issues",
        "email": "contact@femboyfurry.net"
    },
    "description": "Communicate with the HaritoraX trackers",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "react-native": "./dist/index.js",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./connections/contract": {
            "types": "./dist/connections/contract.d.ts",
            "default": "./dist/connections/contract.js"
        },
        "./connections/serial": {
            "types": "./dist/connections/serial-node.d.ts",
            "default": "./dist/connections/serial-node.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "build": "npm run clean && tsc -p tsconfig.json",
        "clean": "rm -rf dist",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "test": "npm run build && node --test \"test/**/*.test.ts\""
    },
    "author": "JovannMC <jovannmc@femboyfurry.net> (https://femboyfurry.net)",
    "license": "MIT",
    "keywords": [
        "haritora",
        "haritorax",
        "shiftall",
        "gx6",
        "gx2",
        "bluetooth",
        "interpreter"
    ],
    "peerDependencies": {
        "@serialport/bindings-cpp": "^13.0.1",
        "@serialport/stream": "^13.0.0",
        "@stoprocent/noble": "^2.3.6",
        "node-ble": "^1.13.0"
    },
    "peerDependenciesMeta": {
        "@serialport/bindings-cpp": {
            "optional": true
        },
        "@serialport/stream": {
            "optional": true
        },
        "@stoprocent/noble": {
            "optional": true
        },
        "node-ble": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@serialport/bindings-cpp": "^13.0.1",
        "@serialport/stream": "^13.0.0",
        "@stoprocent/noble": "^2.3.6",
        "@types/node": "^26.6.5",
        "eslint": "^10.13.0",
        "node-ble": "^1.13.0",
        "prettier": "^3.6.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0"
    }
}
