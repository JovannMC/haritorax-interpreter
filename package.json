{
    "name": "haritorax-interpreter",
    "version": "4.2.0",
    "homepage": "https://github.com/JovannMC/haritorax-interpreter",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JovannMC/haritorax-interpreter.git"
    },
    "bugs": {
        "url": "https://github.com/JovannMC/haritorax-interpreter/issues",
        "email": "hello@jovann.me"
    },
    "description": "Communicate with the HaritoraX trackers",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "haritorax-trace": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./mobile": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./connections/contract": {
            "types": "./dist/connections/contract.d.ts",
            "default": "./dist/connections/contract.js"
        },
        "./connections/serial": {
            "types": "./dist/connections/serial/serial-node.d.ts",
            "default": "./dist/connections/serial/serial-node.js"
        },
        "./connections/ble": {
            "types": "./dist/connections/ble/noble.d.ts",
            "default": "./dist/connections/ble/noble.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "build": "npm run clean && tsc -p tsconfig.json && node scripts/fix-bin-mode.mjs",
        "clean": "node scripts/clean.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "typecheck:test": "npm run build && tsc -p tsconfig.test.json --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:test && npm run test",
        "check:release-version": "node scripts/check-release-version.mjs",
        "trace": "node dist/cli.js",
        "test": "npm run build && node --test \"test/**/*.test.ts\""
    },
    "author": "JovannMC <hello@jovann.me> (https://jovann.me)",
    "license": "MIT",
    "keywords": [
        "haritora",
        "haritorax",
        "shiftall",
        "gx6",
        "gx2",
        "bluetooth",
        "ble",
        "serial",
        "interpreter"
    ],
    "peerDependencies": {
        "@serialport/bindings-cpp": "^13.0.1",
        "@serialport/stream": "^13.0.0",
        "@stoprocent/noble": "^2.8.0",
        "dbus-next": "^0.10.0"
    },
    "peerDependenciesMeta": {
        "@serialport/bindings-cpp": {
            "optional": true
        },
        "@serialport/stream": {
            "optional": true
        },
        "@stoprocent/noble": {
            "optional": true
        },
        "dbus-next": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@serialport/bindings-cpp": "^13.0.1",
        "@serialport/stream": "^13.0.0",
        "@stoprocent/noble": "^2.8.0",
        "@types/node": "^26.6.6",
        "dbus-next": "^0.10.2",
        "eslint": "^10.14.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "dependencies": {
        "base64-js": "^1.5.1"
    },
    "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
